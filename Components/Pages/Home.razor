    private void TriggerShoutout(ShoutoutType type, int bonus, int multiplier)
    {
        if (type == ShoutoutType.None) return;

        currentShoutout = type;
        currentShoutoutBonus = bonus;
        currentShoutoutMultiplier = multiplier;
        showShoutoutBanner = true;
        shoutoutDisplayKey++;

        // Trigger voice shoutout audio in JS (with built-in anti-spam duplicate protection)
        string word = type.ToString().ToLower();
        _ = JS.InvokeVoidAsync("blockBlastAudio.playShoutout", word);

        _shoutoutCts?.Cancel();
        _shoutoutCts?.Dispose();
        _shoutoutCts = new CancellationTokenSource();
        var token = _shoutoutCts.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(2200, token);
                if (!token.IsCancellationRequested)
                {
                    showShoutoutBanner = false;
                    await InvokeAsync(StateHasChanged);
                }
            }
            catch (OperationCanceledException) { }
        });
    }

    private static string GetShoutoutTitle(ShoutoutType type) => type switch
    {
        ShoutoutType.Good => "GOOD!",
        ShoutoutType.Great => "GREAT!",
        ShoutoutType.Impressive => "IMPRESSIVE!",
        ShoutoutType.Excellent => "EXCELLENT!",
        ShoutoutType.Amazing => "AMAZING!",
        ShoutoutType.Unbelievable => "UNBELIEVABLE!",
        ShoutoutType.Insane => "INSANE!",
        _ => string.Empty
    };

    public void Dispose()
    {
        Game.OnStateChanged -= HandleGameStateChanged;
        Game.OnGameOver -= HandleGameOver;
        Game.OnLinesCleared -= HandleLinesCleared;
        _shoutoutCts?.Cancel();
        _shoutoutCts?.Dispose();
        dotNetHelper?.Dispose();
    }
