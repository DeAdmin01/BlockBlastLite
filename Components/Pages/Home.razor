        isHapticsEnabled = Preferences.Get("bb_haptics", true);

        // Audio Submenu Preferences
        isBgmEnabled = Preferences.Get("bb_bgm_enabled", true);
        currentBgmTrack = Preferences.Get("bb_bgm_track", "aero"); // Default Aero
        bgmVolumePercent = Preferences.Get("bb_bgm_volume", 25); // Default 25%
        isSfxEnabled = Preferences.Get("bb_sfx_enabled", true);
        sfxVolumePercent = Preferences.Get("bb_sfx_volume", 100);
        isVoiceEnabled = Preferences.Get("bb_voice_enabled", true);
        currentVoiceGender = Preferences.Get("bb_voice_gender", "mixed");
        voiceVolumePercent = Preferences.Get("bb_voice_volume", 100);

        dragOffsetY = Preferences.Get("bb_drag_offset", 125);
        sliderPercent = OffsetToSliderPercent(dragOffsetY);

        Game.OnStateChanged += HandleGameStateChanged;
        Game.OnGameOver += HandleGameOver;
        Game.OnLinesCleared += HandleLinesCleared;

        Game.StartNewGame(savedHighScore);
        await Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                dotNetHelper = DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("gameInterop.registerHelper", dotNetHelper);
                await JS.InvokeVoidAsync("blockBlastAudio.setMuted", isSoundMuted);
                await JS.InvokeVoidAsync("gameInterop.setFingerOffsetY", dragOffsetY);

                // Apply initial audio settings to audio engine
                await JS.InvokeVoidAsync("blockBlastAudio.setBgmTrack", currentBgmTrack);
                await JS.InvokeVoidAsync("blockBlastAudio.setBgmVolume", bgmVolumePercent / 100.0);
                await JS.InvokeVoidAsync("blockBlastAudio.setBgmEnabled", isBgmEnabled);
                await JS.InvokeVoidAsync("blockBlastAudio.setSfxEnabled", isSfxEnabled);
                await JS.InvokeVoidAsync("blockBlastAudio.setSfxVolume", sfxVolumePercent / 100.0);
                await JS.InvokeVoidAsync("blockBlastAudio.setVoiceEnabled", isVoiceEnabled);
                await JS.InvokeVoidAsync("blockBlastAudio.setVoiceVolume", voiceVolumePercent / 100.0);
                await JS.InvokeVoidAsync("blockBlastAudio.setVoiceGender", currentVoiceGender);

                await ApplyThemeAsync(currentTheme);
                await JS.InvokeVoidAsync("gameInterop.applySkin", currentSkin);
                await JS.InvokeVoidAsync("gameInterop.dismissPreloader");
            }
            catch
            {
                // Gracefully handle the case where JS isn't ready yet on first render
            }
        }
    }

    private static int SliderPercentToOffset(int percent)
    {
        if (percent <= 50)
        {
            return (int)Math.Round((percent / 50.0) * 125.0);
        }
        else
        {
            return (int)Math.Round(125.0 + ((percent - 50.0) / 50.0) * 75.0);
        }
    }

    private static int OffsetToSliderPercent(int offset)
    {
        if (offset <= 125)
        {
            return (int)Math.Round((Math.Max(0, offset) / 125.0) * 50.0);
        }
        else
        {
            return (int)Math.Round(50.0 + ((Math.Min(200, offset) - 125.0) / 75.0) * 50.0);
        }
    }

