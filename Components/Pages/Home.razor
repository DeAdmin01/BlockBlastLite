@page "/"
@implements IDisposable
@inject GameEngine Game
@inject IDynamicThemeService DynamicTheme
@inject IJSRuntime JS

<div class="game-app-container skin-@currentSkin" data-skin="@currentSkin">
    <!-- Top Header -->
    <header class="game-header">
        <div class="brand-section">
            <div class="brand-icon">
                <SvgIcon Name="logo" />
            </div>
            <span class="brand-title">BLOCK BLAST</span>
        </div>

        <div class="header-actions">
            <button type="button" class="icon-btn" @onclick="ToggleSound" title="Звук">
                <SvgIcon Name="@(isSoundMuted ? "sound-off" : "sound-on")" />
            </button>
            <button type="button" class="icon-btn" data-action="restart" @onclick="RestartGame" title="Новая игра">
                <SvgIcon Name="restart" />
            </button>
            <button type="button" class="icon-btn" @onclick="() => showSettings = true" title="Настройки">
                <SvgIcon Name="settings" />
            </button>
        </div>
    </header>

    <!-- Score & High Score Cards -->
    <section class="score-board">
        <div class="score-card accent-card">
            <div class="score-label-row">
                <SvgIcon Name="score" />
                <span>СЧЁТ</span>
            </div>
            <div class="score-value">@Game.Score</div>
        </div>

        <div class="score-card">
            <div class="score-label-row">
                <SvgIcon Name="trophy" />
                <span>РЕКОРД</span>
            </div>
            <div class="score-value">@Game.HighScore</div>
        </div>
    </section>

    <!-- Combo Streak Notification & Visual Shoutouts -->
    <div class="combo-banner-container">
        @if (showShoutoutBanner && currentShoutout != ShoutoutType.None)
        {
            <div class="shoutout-banner-wrapper" @key="shoutoutDisplayKey">
                <div class="shoutout-badge shoutout-@currentShoutout.ToString().ToLower()">
                    <div class="shoutout-glare"></div>
                    <span class="shoutout-word">@GetShoutoutTitle(currentShoutout)</span>
                    @if (currentShoutoutBonus > 0)
                    {
                        <span class="shoutout-bonus-chip">
                            +@currentShoutoutBonus
                            @if (currentShoutoutMultiplier > 1)
                            {
                                <span class="shoutout-mult-tag">&times;@currentShoutoutMultiplier</span>
                            }
                        </span>
                    }
                </div>
            </div>
        }
        else if (Game.ComboStreak > 1)
        {
            <div class="combo-badge" @key="comboDisplayKey">
                <div class="combo-icon-pill">
                    <SvgIcon Name="zap" Class="combo-icon" />
                </div>
                <span class="combo-text">КОМБО</span>
                <span class="combo-multiplier">&times;@(Game.ComboStreak)</span>
            </div>
        }
    </div>

    <!-- 8x8 Playfield Grid (Isolated Component Optimization) -->
    <BoardView @ref="boardViewRef" Board="Game.Board" CurrentSkin="@currentSkin" OnCellClick="HandleBoardCellClick" />

    <!-- Polyomino Piece Tray -->
    <footer class="piece-tray">
        @foreach (var piece in Game.CurrentPieces)
        {
            var p = piece;
            bool isSelected = selectedPieceId == p.Id;
            string slotClass = "piece-slot";
            if (p.IsUsed) slotClass += " disabled";
            else if (isSelected) slotClass += " selected";

            <div class="@slotClass"
                 id="slot-@p.Id"
                 @onclick="() => HandlePieceSelect(p)"
                 @onpointerdown="(e) => HandlePiecePointerDown(e, p)">
                @if (!p.IsUsed)
                {
                    <GamePieceView Piece="p" Skin="@currentSkin" />
                }
                else
                {
                    <div class="slot-placeholder"></div>
                }
            </div>
        }
    </footer>

    <!-- Floating Drag Ghost for Pointer Dragging -->
    <div id="drag-floating-ghost" class="floating-drag-ghost"></div>

</div>

<!-- Game Over Modal (outside game-app-container to avoid touch-action:none inheritance) -->
@if (Game.IsGameOver)
{
    <div class="modal-overlay">
        <div class="modal-dialog">
            <h2 class="modal-title">ИГРА ОКОНЧЕНА</h2>
            <p class="modal-subtitle">Нет доступных ходов для оставшихся фигур</p>

            <div class="modal-stats">
                <div class="modal-stat-item">
                    <span class="stat-label">СЧЁТ</span>
                    <span class="stat-value">@Game.Score</span>
                </div>
                <div class="modal-stat-item">
                    <span class="stat-label">РЕКОРД</span>
                    <span class="stat-value">@Game.HighScore</span>
                </div>
                <div class="modal-stat-item">
                    <span class="stat-label">МАКС КОМБО</span>
                    <span class="stat-value">&times;@Game.MaxCombo</span>
                </div>
            </div>

            <button type="button" class="primary-btn" @onclick="RestartGame">
                <SvgIcon Name="restart" />
                <span>ИГРАТЬ СНОВА</span>
            </button>
        </div>
    </div>
}

<!-- Settings Modal (outside game-app-container to avoid touch-action:none inheritance) -->
@if (showSettings)
{
    <div class="modal-overlay">
        <div class="modal-dialog">
            <div class="modal-header-row">
                <h2 class="modal-title">НАСТРОЙКИ</h2>
                <button type="button" class="close-icon-btn" @onclick="() => showSettings = false" title="Закрыть">
                    <SvgIcon Name="close" />
                </button>
            </div>
            <p class="modal-subtitle">Внешний вид, скины и звуковые эффекты</p>

            <div class="settings-group">
                <!-- Theme Mode -->
                <div class="settings-row">
                    <div class="settings-row-label">
                        <SvgIcon Name="theme" />
                        <span>Тема</span>
                    </div>
                    <div class="theme-options">
                        <button type="button" class="theme-option-btn @(currentTheme == "system" ? "active" : "")"
                                @onclick='() => ChangeTheme("system")'>
                            Авто
                        </button>
                        <button type="button" class="theme-option-btn @(currentTheme == "dark" ? "active" : "")"
                                @onclick='() => ChangeTheme("dark")'>
                            Тёмная
                        </button>
                        <button type="button" class="theme-option-btn @(currentTheme == "light" ? "active" : "")"
                                @onclick='() => ChangeTheme("light")'>
                            Светлая
                        </button>
                    </div>
                </div>

                <!-- Skin Selector in Settings -->
                <div class="settings-row">
                    <div class="settings-row-label">
                        <SvgIcon Name="logo" />
                        <div>
                            <div>Скин блоков</div>
                            <div class="settings-row-subtext">@GetSkinName(currentSkin)@(isAutoSkinEnabled ? " • Авто" : "")</div>
                        </div>
                    </div>
                    <button type="button" class="settings-action-btn" @onclick="OpenSkinPickerModal">
                        <div class="skin-preview-dot skin-@currentSkin" style="width: 22px; height: 22px; flex-shrink: 0; border-radius: 6px;"></div>
                        <span>Выбрать</span>
                        <span class="action-btn-arrow">&rsaquo;</span>
                    </button>
                </div>

                <!-- Auto Skin Switch -->
                <div class="settings-row">
                    <div class="settings-row-label">
                        <SvgIcon Name="restart" />
                        <span>Авто-смена скина</span>
                    </div>
                    <div class="toggle-switch @(isAutoSkinEnabled ? "checked" : "")"
                         @onclick="ToggleAutoSkin">
                        <div class="toggle-thumb"></div>
                    </div>
                </div>

                <!-- Audio & Music Settings Submenu Action -->
                <div class="settings-row">
                    <div class="settings-row-label">
                        <SvgIcon Name="music" />
                        <div>
                            <div>Звук и музыка</div>
                            <div class="settings-row-subtext">Музыка (@(isBgmEnabled ? $"{(currentBgmTrack == "quiet" ? "Quiet Geometry" : "Aero")}, {bgmVolumePercent}%" : "выкл")), эффекты, голос</div>
                        </div>
                    </div>
                    <button type="button" class="settings-action-btn" @onclick="OpenAudioSettingsModal">
                        <span>Настроить</span>
                        <span class="action-btn-arrow">&rsaquo;</span>
                    </button>
                </div>

                <!-- Master Mute Quick Switch -->
                <div class="settings-row">
                    <div class="settings-row-label">
                        <SvgIcon Name="@(isSoundMuted ? "sound-off" : "sound-on")" />
                        <span>Общий звук (Mute)</span>
                    </div>
                    <div class="toggle-switch @(!isSoundMuted ? "checked" : "")"
                         @onclick="ToggleSound">
                        <div class="toggle-thumb"></div>
                    </div>
                </div>

                <!-- Haptics / Vibration Switch -->
                <div class="settings-row">
                    <div class="settings-row-label">
                        <SvgIcon Name="zap" />
                        <span>Виброотклик (Haptic)</span>
                    </div>
                    <div class="toggle-switch @(isHapticsEnabled ? "checked" : "")"
                         @onclick="ToggleHaptics">
                        <div class="toggle-thumb"></div>
                    </div>
                </div>

                <!-- Drag Offset Setting (Finger Offset Slider) -->
                <div class="settings-row-col">
                    <div class="settings-slider-header">
                        <div class="settings-row-label">
                            <SvgIcon Name="offset" />
                            <div>
                                <div>Отступ при переносе</div>
                                <div class="settings-row-subtext">Высота блока над пальцем</div>
                            </div>
                        </div>
                        <button type="button" class="settings-value-badge @(dragOffsetY == 125 ? "is-default" : "")"
                                @onclick="() => SetOffsetDirect(125)"
                                title="Сбросить на значение по умолчанию">
                            @dragOffsetY px @(dragOffsetY == 125 ? "(Стандарт)" : "")
                        </button>
                    </div>

                    <div class="settings-slider-container">
                        <input type="range"
                               class="tactile-range-slider"
                               min="0"
                               max="100"
                               step="1"
                               value="@sliderPercent"
                               @oninput="OnDragOffsetSliderInput" />
                        <div class="settings-slider-ticks">
                            <span class="tick-label @(dragOffsetY == 0 ? "active" : "")" @onclick="() => SetOffsetDirect(0)">0 px</span>
                            <span class="tick-label tick-center @(dragOffsetY == 125 ? "active" : "")" @onclick="() => SetOffsetDirect(125)">125 px (Центр)</span>
                            <span class="tick-label @(dragOffsetY == 200 ? "active" : "")" @onclick="() => SetOffsetDirect(200)">200 px (+75)</span>
                        </div>
                    </div>
                </div>
            </div>

            <button type="button" class="primary-btn" @onclick="() => showSettings = false">
                <span>ГОТОВО</span>
            </button>
        </div>
    </div>
}

<!-- Dedicated Skin Selection Modal -->
@if (showSkinPickerModal)
{
    <div class="modal-overlay" @onclick="CloseSkinPickerModal">
        <div class="modal-dialog skin-picker-modal-card" @onclick:stopPropagation="true">
            <div class="modal-header-row" style="margin-bottom: 8px;">
                <div class="skin-picker-header-title">
                    <h2 class="modal-title" style="margin: 0; font-size: 1.22rem;">КОЛЛЕКЦИЯ ТЕМ</h2>
                    <span class="skins-count-badge">@_availableSkins.Count тем</span>
                </div>
                <button type="button" class="close-icon-btn" @onclick="CloseSkinPickerModal" title="Закрыть">
                    <SvgIcon Name="close" />
                </button>
            </div>

            <div class="modal-body skin-picker-body">
                <!-- Auto-Skin Option Switch -->
                <div class="skin-auto-banner @(isAutoSkinEnabled ? "active" : "")" @onclick="ToggleAutoSkin">
                    <div class="skin-auto-info">
                        <SvgIcon Name="restart" />
                        <div class="skin-auto-text">
                            <div class="skin-auto-title">Случайная тема</div>
                            <div class="skin-auto-sub">Новый скин каждый раунд</div>
                        </div>
                    </div>
                    <div class="toggle-switch @(isAutoSkinEnabled ? "checked" : "")">
                        <div class="toggle-thumb"></div>
                    </div>
                </div>

                <!-- 25 Skins Grid -->
                <div class="skin-picker-grid">
                    @foreach (var skin in _availableSkins)
                    {
                        string s = skin.Key;
                        bool isActive = currentSkin == s && !isAutoSkinEnabled;
                        <button type="button"
                                class="skin-picker-card @(isActive ? "selected" : "")"
                                @onclick="() => SelectSkinFromPicker(s)">
                            <div class="skin-card-preview-wrapper">
                                <div class="skin-preview-dot skin-card-preview-dot skin-@s"></div>
                            </div>
                            <div class="skin-card-info">
                                <span class="skin-card-name">@skin.Value</span>
                                @if (isActive)
                                {
                                    <span class="skin-card-active-badge">Активен</span>
                                }
                            </div>
                        </button>
                    }
                </div>
            </div>

            <div class="modal-footer" style="padding-top: 12px;">
                <button type="button" class="primary-btn" style="width: 100%;" @onclick="CloseSkinPickerModal">
                    <span>ГОТОВО</span>
                </button>
            </div>
        </div>
    </div>
}

<!-- Dedicated Audio & Music Settings Submenu Modal -->
@if (showAudioSettingsModal)
{
    <div class="modal-overlay" @onclick="CloseAudioSettingsModal">
        <div class="modal-dialog" @onclick:stopPropagation="true">
            <div class="modal-header-row">
                <div style="display: flex; align-items: center; gap: 8px;">
                    <SvgIcon Name="music" />
                    <h2 class="modal-title" style="margin: 0; font-size: 1.25rem;">ЗВУК И МУЗЫКА</h2>
                </div>
                <button type="button" class="close-icon-btn" @onclick="CloseAudioSettingsModal" title="Закрыть">
                    <SvgIcon Name="close" />
                </button>
            </div>
            <p class="modal-subtitle">Настройка фона, эффектов фигурок и голоса</p>

            <div class="settings-group">
                <!-- 1. BGM SECTION -->
                <div class="audio-subgroup-title">Фоновая музыка</div>

                <div class="settings-row">
                    <div class="settings-row-label">
                        <SvgIcon Name="music" />
                        <span>Музыка в игре</span>
                    </div>
                    <div class="toggle-switch @(isBgmEnabled ? "checked" : "")"
                         @onclick="ToggleBgm">
                        <div class="toggle-thumb"></div>
                    </div>
                </div>

                <!-- BGM Track Selector (Aero vs Quiet Geometry) -->
                <div class="settings-row-col">
                    <div class="settings-slider-header">
                        <div class="settings-row-label">
                            <span>Выбор трека</span>
                        </div>
                        <span class="settings-value-badge">@(currentBgmTrack == "quiet" ? "Quiet Geometry" : "Aero")</span>
                    </div>
                    <div class="audio-segment-control">
                        <button type="button" class="audio-segment-btn @(currentBgmTrack == "quiet" ? "active" : "")"
                                @onclick='() => ChangeBgmTrack("quiet")'>
                            Quiet Geometry
                        </button>
                        <button type="button" class="audio-segment-btn @(currentBgmTrack == "aero" ? "active" : "")"
                                @onclick='() => ChangeBgmTrack("aero")'>
                            Aero
                        </button>
                    </div>
                </div>

                <!-- BGM Volume Slider -->
                <div class="settings-row-col">
                    <div class="settings-slider-header">
                        <div class="settings-row-label">
                            <SvgIcon Name="volume" />
                            <span>Громкость музыки</span>
                        </div>
                        <span class="settings-value-badge">@bgmVolumePercent%</span>
                    </div>
                    <div class="settings-slider-container">
                        <input type="range"
                               class="tactile-range-slider"
                               min="0"
                               max="100"
                               step="5"
                               value="@bgmVolumePercent"
                               @oninput="OnBgmVolumeInput" />
                    </div>
                </div>

                <!-- 2. SFX SECTION -->
                <div class="audio-subgroup-title">Звуки фигурок</div>

                <div class="settings-row">
                    <div class="settings-row-label">
                        <SvgIcon Name="zap" />
                        <span>Эффекты фигурок</span>
                    </div>
                    <div class="toggle-switch @(isSfxEnabled ? "checked" : "")"
                         @onclick="ToggleSfx">
                        <div class="toggle-thumb"></div>
                    </div>
                </div>

                <!-- SFX Volume Slider -->
                <div class="settings-row-col">
                    <div class="settings-slider-header">
                        <div class="settings-row-label">
                            <SvgIcon Name="volume" />
                            <span>Громкость эффектов</span>
                        </div>
                        <span class="settings-value-badge">@sfxVolumePercent%</span>
                    </div>
                    <div class="settings-slider-container">
                        <input type="range"
                               class="tactile-range-slider"
                               min="0"
                               max="100"
                               step="5"
                               value="@sfxVolumePercent"
                               @oninput="OnSfxVolumeInput" />
                    </div>
                </div>

                <!-- 3. VOICE SECTION -->
                <div class="audio-subgroup-title">Голос комментатора</div>

                <div class="settings-row">
                    <div class="settings-row-label">
                        <SvgIcon Name="mic" />
                        <span>Выкрики при комбо</span>
                    </div>
                    <div class="toggle-switch @(isVoiceEnabled ? "checked" : "")"
                         @onclick="ToggleVoice">
                        <div class="toggle-thumb"></div>
                    </div>
                </div>

                <!-- Voice Gender Selector (Male / Female / Mixed) -->
                <div class="settings-row-col">
                    <div class="settings-slider-header">
                        <div class="settings-row-label">
                            <span>Тип голоса</span>
                        </div>
                        <span class="settings-value-badge">
                            @(currentVoiceGender == "female" ? "Женский" : (currentVoiceGender == "male" ? "Мужской" : "Вперемешку"))
                        </span>
                    </div>
                    <div class="audio-segment-control">
                        <button type="button" class="audio-segment-btn @(currentVoiceGender == "male" ? "active" : "")"
                                @onclick='() => ChangeVoiceGender("male")'>
                            Мужской
                        </button>
                        <button type="button" class="audio-segment-btn @(currentVoiceGender == "female" ? "active" : "")"
                                @onclick='() => ChangeVoiceGender("female")'>
                            Женский
                        </button>
                        <button type="button" class="audio-segment-btn @(currentVoiceGender == "mixed" ? "active" : "")"
                                @onclick='() => ChangeVoiceGender("mixed")'>
                            Вперемешку
                        </button>
                    </div>
                </div>

                <!-- Voice Volume Slider -->
                <div class="settings-row-col">
                    <div class="settings-slider-header">
                        <div class="settings-row-label">
                            <SvgIcon Name="volume" />
                            <span>Громкость голоса</span>
                        </div>
                        <span class="settings-value-badge">@voiceVolumePercent%</span>
                    </div>
                    <div class="settings-slider-container">
                        <input type="range"
                               class="tactile-range-slider"
                               min="0"
                               max="100"
                               step="5"
                               value="@voiceVolumePercent"
                               @oninput="OnVoiceVolumeInput" />
                    </div>
                </div>
            </div>

            <button type="button" class="primary-btn" @onclick="CloseAudioSettingsModal">
                <span>СОХРАНИТЬ</span>
            </button>
        </div>
    </div>
}


