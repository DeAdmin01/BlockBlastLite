    private async Task ProcessPlacementOutcome(PlacementResult result)
    {
        // 1. Play place sound and haptics
        await JS.InvokeVoidAsync("blockBlastAudio.playPlace");

        if (isHapticsEnabled)
        {
            if (result.ClearedLinesCount > 0)
            {
                HapticService.Heavy();
                await JS.InvokeVoidAsync("gameInterop.vibrateHaptic", 45);
            }
            else
            {
                HapticService.Click();
                await JS.InvokeVoidAsync("gameInterop.vibrateHaptic", 20);
            }
        }

        // 2. If lines cleared
        if (result.ClearedLinesCount > 0)
        {
            int totalCells = (result.ClearedRows.Count * 8) + (result.ClearedCols.Count * 8)
                - (result.ClearedRows.Count * result.ClearedCols.Count);

            await JS.InvokeVoidAsync("blockBlastAudio.playLineClear", totalCells, result.ClearedLinesCount, result.ComboStreak);

            if (isHapticsEnabled)
            {
                if (result.ClearedLinesCount >= 3)
                {
                    HapticService.Heavy();
                    _ = JS.InvokeVoidAsync("gameInterop.vibrateHaptic", 65);
                }
                else if (result.ClearedLinesCount == 2)
                {
                    HapticService.Medium();
                    _ = JS.InvokeVoidAsync("gameInterop.vibrateHaptic", 40);
                }
                else
                {
                    HapticService.Click();
                    _ = JS.InvokeVoidAsync("gameInterop.vibrateHaptic", 25);
                }
            }

            comboDisplayKey++;
            StateHasChanged();

            // Allow blast pop and shockwave animations to play out gorgeously
            await Task.Delay(340);

            // Finish clearing lines in the game engine (resets cells, spawns new trio, checks game over)
            bool isBoardClear = Game.FinishLineClearing(result.ClearedRows, result.ClearedCols);
            if (isBoardClear)
            {
                await JS.InvokeVoidAsync("blockBlastAudio.playBoardClear");
                HapticService.Success();
                var clearShoutout = (result.Shoutout == ShoutoutType.Insane) ? ShoutoutType.Insane : ShoutoutType.Unbelievable;
                TriggerShoutout(clearShoutout, result.ShoutoutBonusPoints > 0 ? result.ShoutoutBonusPoints : (clearShoutout == ShoutoutType.Insane ? 1200 : 800) * Math.Max(1, result.ComboStreak), result.ShoutoutMultiplier);
            }
            else if (result.Shoutout != ShoutoutType.None)
            {
                TriggerShoutout(result.Shoutout, result.ShoutoutBonusPoints, result.ShoutoutMultiplier);
            }
            StateHasChanged();
        }
        else
        {
            // Non-clearing placement: check if it was a lucky / strategic placement
            if (result.Shoutout != ShoutoutType.None)
            {
                TriggerShoutout(result.Shoutout, result.ShoutoutBonusPoints, result.ShoutoutMultiplier);
            }

            if (Game.ComboStreak > 0)
            {
                // Combo grace period renewed on placement
                comboDisplayKey++;
            }
            StateHasChanged();
        }

        // 3. Update high score in persistent storage
        if (Game.Score >= Game.HighScore)
        {
            Preferences.Set("bb_high_score", Game.HighScore);
        }

        // 4. If new round trio was spawned and auto-skin is enabled, rotate skin at a comfortable interval!
        if (isAutoSkinEnabled && Game.CurrentPieces.All(p => !p.IsUsed))
        {
            _autoSkinRoundCounter++;
            if (_autoSkinRoundCounter >= AutoSkinRoundsInterval)
            {
                _autoSkinRoundCounter = 0;
                RotateRandomSkin();
            }
        }
    }

