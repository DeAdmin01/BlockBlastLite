    private async Task RestartGame()
    {
        try
        {
            selectedPieceId = null;
            showSettings = false;
            showShoutoutBanner = false;
            currentShoutout = ShoutoutType.None;
            _shoutoutCts?.Cancel();
            PieceLibrary.ResetPacing();

            try
            {
                await JS.InvokeVoidAsync("gameInterop.hideDragGhost");
                await JS.InvokeVoidAsync("blockBlastAudio.playClick");
            }
            catch { }

            if (isHapticsEnabled)
            {
                HapticService.Click();
            }

            if (isAutoSkinEnabled && _autoSkinRoundCounter >= 3)
            {
                _autoSkinRoundCounter = 0;
                RotateRandomSkin();
            }

            Game.StartNewGame();
        }
        catch (Exception)
        {
            // Defensive recovery
            Game.StartNewGame();
        }
        finally
        {
            StateHasChanged();
        }
    }

    private void HandlePieceSelect(GamePiece piece)
    {
        if (piece.IsUsed || Game.IsGameOver) return;

        if (selectedPieceId == piece.Id)
        {
            selectedPieceId = null;
            Game.ClearPreview();
        }
        else
        {
            selectedPieceId = piece.Id;
            if (isHapticsEnabled) HapticService.Click();
            _ = JS.InvokeVoidAsync("blockBlastAudio.playPickup");
        }
    }

    private async Task HandleBoardCellClick((int row, int col) pos) => await HandleCellClick(pos.row, pos.col);

    private async Task HandleCellClick(int row, int col)
    {
        if (string.IsNullOrEmpty(selectedPieceId) || Game.IsGameOver) return;

        var piece = Game.CurrentPieces.FirstOrDefault(p => p.Id == selectedPieceId);
        if (piece == null || piece.IsUsed) return;

        if (Game.CanPlacePiece(piece, row, col))
        {
            var result = Game.PlacePiece(piece, row, col);
            if (result.Success)
            {
                selectedPieceId = null;
                Game.ClearPreview();
                await ProcessPlacementOutcome(result);
            }
        }
        else
        {
            await JS.InvokeVoidAsync("blockBlastAudio.playInvalid");
            if (isHapticsEnabled)
            {
                HapticService.Heavy();
                await JS.InvokeVoidAsync("gameInterop.vibrateHaptic", 35);
            }
        }
    }

    private async Task HandlePiecePointerDown(PointerEventArgs e, GamePiece piece)
    {
        if (piece.IsUsed || Game.IsGameOver) return;

        selectedPieceId = piece.Id;
        bool isTouch = e.PointerType == "touch";

        if (isHapticsEnabled) HapticService.Click();

        await JS.InvokeVoidAsync("gameInterop.startDragFromElement", $"slot-{piece.Id}", piece.Id, piece.Rows, piece.Cols, e.ClientX, e.ClientY);
    }

